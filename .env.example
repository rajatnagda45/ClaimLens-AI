# Copy to .env and fill in. NEVER commit a real key.
OPENAI_API_KEY=sk-your-key-here

# Model + execution tunables (optional; shown with defaults)
CLAIMLENS_MODEL=gpt-4o-mini
CLAIMLENS_PROVIDER=openai
CLAIMLENS_MAX_TURNS=3
CLAIMLENS_TIMEOUT_S=90
CLAIMLENS_TEMPERATURE=0

# PostgreSQL connection (SQLAlchemy + psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://localhost:5432/claimlens
